rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Reminder/acknowledgement IDs contain deterministic colons, so allow
    // those while still rejecting path separators and unbounded identifiers.
    function isValidId(id) {
      return id is string &&
             id.size() > 0 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-:.]+$');
    }

    function hasOwner(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128;
    }

    function isValidMemory(data, userId) {
      return hasOwner(data, userId) &&
             data.content is string &&
             data.content.size() > 0 &&
             data.content.size() <= 10000 &&
             data.createdAt is number &&
             (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidNote(data, userId) {
      return hasOwner(data, userId) &&
             data.content is string &&
             data.content.size() <= 20000 &&
             data.createdAt is number &&
             (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidTask(data, userId) {
      return hasOwner(data, userId) &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 1000 &&
             data.createdAt is number &&
             (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidBill(data, userId) {
      return hasOwner(data, userId) &&
             data.description is string &&
             data.description.size() > 0 &&
             data.description.size() <= 1000 &&
             data.amount is number &&
             data.createdAt is number &&
             (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidGoal(data, userId) {
      return hasOwner(data, userId) &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 1000 &&
             data.createdAt is number &&
             (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidReminder(data, userId) {
      return hasOwner(data, userId) &&
             data.id is string &&
             data.id.size() > 0 &&
             data.id.size() <= 128 &&
             data.title is string &&
             data.title.size() <= 1000 &&
             data.dueAt is number &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             (!('reminderState' in data) ||
               data.reminderState in ['active', 'completed', 'cancelled', 'passed', 'acknowledged']) &&
             (!('notificationState' in data) ||
               data.notificationState in ['pending', 'claimed', 'accepted', 'failed']);
    }

    function isValidAcknowledgement(data, userId) {
      return hasOwner(data, userId) &&
             data.ackId is string &&
             data.eventId is string &&
             data.reminderId is string &&
             data.channel in ['in_app', 'push', 'browser', 'tts'] &&
             data.status in ['pending', 'delivered', 'acknowledged', 'failed'] &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('deliveredAt' in data) || data.deliveredAt is number) &&
             (!('acknowledgedAt' in data) || data.acknowledgedAt is number) &&
             (!('userConfirmationText' in data) ||
               (data.userConfirmationText is string && data.userConfirmationText.size() <= 2000)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 1000)) &&
             (!('dueAt' in data) || data.dueAt is number) &&
             (!('version' in data) || data.version is number);
    }

    function isValidDiagnostic(data, userId) {
      return hasOwner(data, userId) &&
             data.diagnosticId is string &&
             data.correlationId is string &&
             data.stage is string &&
             data.action is string &&
             data.status is string &&
             data.timestamp is number;
    }

    function isValidPushSubscription(data, userId, subscriptionId) {
      return hasOwner(data, userId) &&
             data.subscriptionId == subscriptionId &&
             data.subscriptionId is string &&
             data.subscriptionId.size() <= 128 &&
             data.endpoint is string &&
             data.endpoint.size() <= 2048 &&
             data.endpoint.matches('^https://[^ ]+$') &&
             data.keys is map &&
             data.keys.p256dh is string &&
             data.keys.p256dh.size() > 0 &&
             data.keys.p256dh.size() <= 256 &&
             data.keys.auth is string &&
             data.keys.auth.size() > 0 &&
             data.keys.auth.size() <= 256 &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('expirationTime' in data) ||
               data.expirationTime == null || data.expirationTime is number) &&
             (!('userAgent' in data) ||
               (data.userAgent is string && data.userAgent.size() <= 500));
    }

    match /users/{userId}/memories/{memoryId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(memoryId) &&
        isValidMemory(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(memoryId);
    }

    match /users/{userId}/notes/{noteId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(noteId) &&
        isValidNote(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(noteId);
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(taskId) &&
        isValidTask(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(taskId);
    }

    match /users/{userId}/bills/{billId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(billId) &&
        isValidBill(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(billId);
    }

    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(goalId) &&
        isValidGoal(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(goalId);
    }

    match /users/{userId}/reminders/{reminderId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(reminderId) &&
        isValidReminder(request.resource.data, userId) &&
        !('workerId' in request.resource.data) &&
        !('claimedAt' in request.resource.data) &&
        !('acceptedAt' in request.resource.data) &&
        !('failedAt' in request.resource.data);
      allow delete: if isOwner(userId) && isValidId(reminderId);
    }

    match /users/{userId}/acknowledgements/{ackId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(ackId) &&
        isValidAcknowledgement(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(ackId);
    }

    match /users/{userId}/notificationDiagnostics/{diagnosticId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(diagnosticId) &&
        isValidDiagnostic(request.resource.data, userId);
      allow delete: if isOwner(userId) && isValidId(diagnosticId);
    }

    match /users/{userId}/pushSubscriptions/{subscriptionId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(subscriptionId) &&
        isValidPushSubscription(request.resource.data, userId, subscriptionId);
      allow delete: if isOwner(userId) && isValidId(subscriptionId);
    }

    // Client-owned delivery history is synchronized across the user's devices.
    match /users/{userId}/notificationDeliveries/{deliveryId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        isValidId(deliveryId) &&
        hasOwner(request.resource.data, userId) &&
        request.resource.data.deliveryId == deliveryId &&
        request.resource.data.eventId is string &&
        request.resource.data.reminderId is string &&
        request.resource.data.messageId is string &&
        request.resource.data.channel is string &&
        request.resource.data.status in ['pending', 'delivering', 'delivered', 'failed'] &&
        request.resource.data.createdAt is number &&
        request.resource.data.updatedAt is number &&
        request.resource.data.retryCount is number;
      allow delete: if isOwner(userId) && isValidId(deliveryId);
    }

    match /users/{userId}/migration/state {
      allow read, write: if isOwner(userId);
    }

    // Server-owned push delivery claims/results cannot be forged by clients.
    // The owner may read and delete their own markers so account wipe can clean them.
    match /users/{userId}/pushDeliveries/{deliveryId} {
      allow read: if isOwner(userId);
      allow create, update: if false;
      allow delete: if isOwner(userId) && isValidId(deliveryId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
