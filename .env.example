GITHUB_TOKEN=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Browser-visible VAPID public key; must match the server-side pair below.
VITE_VAPID_PUBLIC_KEY=

# Server-only Web Push configuration.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Server-only Firebase Admin REST access for scheduled push delivery.
# Store the complete service-account JSON as one environment-variable value.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
# Use the exact Firestore database ID configured by the Firebase app.
FIRESTORE_DATABASE_ID=

# At least 32 random characters. Also configure the same value as the
# GitHub Actions secret ALPHA_CRON_SECRET.
ALPHA_CRON_SECRET=

# Deployed HTTPS origin used by the GitHub Actions scheduled-push workflow.
# Configure this as the repository variable ALPHA_BASE_URL, not as a secret.
ALPHA_BASE_URL=
